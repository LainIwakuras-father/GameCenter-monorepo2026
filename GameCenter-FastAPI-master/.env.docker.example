# Docker Compose variables. Copy this file to .env.docker and replace every
# placeholder before starting the production stack.
POSTGRES_USER=gamecenter
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=gamecenter

SECRET_KEY=replace-with-a-long-random-application-secret-key
ADMIN_SECRET_KEY=replace-with-a-long-random-admin-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

ADMIN_USER_MODEL=User
ADMIN_USER_MODEL_USERNAME_FIELD=username
CORS_ORIGINS=http://localhost
