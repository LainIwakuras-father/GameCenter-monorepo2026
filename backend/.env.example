DB_ENGINE=tortoise.backends.asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamecenter
DB_USER=postgres
DB_PASS=change-me-to-a-database-password

SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ADMIN_SECRET_KEY=change-me-to-a-long-random-admin-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

ENVIRONMENT=development
ADMIN_USER_MODEL=User
ADMIN_USER_MODEL_USERNAME_FIELD=username

CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
